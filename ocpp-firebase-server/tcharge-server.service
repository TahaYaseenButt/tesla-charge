[Unit]
Description=T-Charge OCPP 1.6-J & Firebase Central Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ocpp-firebase-server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tcharge-ocpp

[Install]
WantedBy=multi-user.target
